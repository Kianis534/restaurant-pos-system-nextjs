# Copy this file to .env.local and change what you need:
#
#   cp .env.example .env.local
#
# Every variable here is optional. The app runs with no .env file at all.
#
# Heads-up: anything starting with NEXT_PUBLIC_ is baked into the JavaScript bundle at build
# time and is visible to anyone who opens the site. Never put a real secret (API key, token,
# plain-text password) in a NEXT_PUBLIC_ variable. This app doesn't need any secrets.

# Name shown in the header, on the sign-in page and at the top of new receipts.
NEXT_PUBLIC_APP_NAME=Restaurant POS

# ISO 4217 currency code and BCP 47 locale used to format prices, e.g. PKR + en-PK, EUR + de-DE.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US

# Sub-folder the site is served from. Leave empty for local dev or a root domain.
# GitHub Pages project sites need /<repository-name>, e.g. /restaurant-pos-system-nextjs
# (the included deploy workflow sets this for you).
NEXT_PUBLIC_BASE_PATH=

# --- Bring your own passwords -------------------------------------------------------------
# The demo accounts use well-known passwords (admin123, cashier123, kitchen123). For anything
# other than a demo, replace them with your own. Generate a hash (never the password itself):
#
#   npm run hash-password -- "a long passphrase"
#
# and paste the output below. Hashes only apply when a browser loads the app for the first
# time (or after Settings -> Reset to demo data). You can also just sign in as admin001 and
# change every password from Employees.
NEXT_PUBLIC_ADMIN_PASSWORD_HASH=
# Used for both the cashier001 and kitchen001 demo accounts.
NEXT_PUBLIC_STAFF_PASSWORD_HASH=

# Show the demo logins on the sign-in page. Defaults to true, and turns off automatically when
# you set either hash above.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=
