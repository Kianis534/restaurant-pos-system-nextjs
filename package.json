{
  "name": "restaurant-pos-system",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurant point of sale (POS) system built with Next.js, React, TypeScript and Tailwind CSS. Dine-in and takeaway orders, kitchen display, receipts, menu, staff, discounts and sales reports. Runs fully in the browser.",
  "author": "Muhammad Abdullah Raja (https://github.com/Kianis534)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kianis534/restaurant-pos-system-nextjs.git"
  },
  "homepage": "https://github.com/Kianis534/restaurant-pos-system-nextjs#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.mjs",
    "start": "serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "check:site": "node scripts/check-links.mjs --site out",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.554.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.6",
    "serve": "^14.2.8",
    "tailwindcss": "^4.1.17",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
